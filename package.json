{
	"name": "facebook-reels-blocker",
	"version": "0.3.0",
	"description": "web extension to block facebook reels in your feed",
	"scripts": {
		"build": "node scripts/build.mjs",
		"build:chrome": "node scripts/build.mjs chrome",
		"build:firefox": "node scripts/build.mjs firefox",
		"typecheck": "tsc --noEmit",
		"test": "node --test \"test/*.test.mjs\"",
		"lint": "npx --yes web-ext lint -s dist/firefox",
		"zip": "npx --yes web-ext build -s dist/chrome -a dist/zip -n chrome.zip --overwrite-dest && npx --yes web-ext build -s dist/firefox -a dist/zip -n firefox.zip --overwrite-dest",
		"video": "remotion studio remotion/index.ts",
		"video:render": "remotion render remotion/index.ts FacebookReelsBlockerPromo out/promo.mp4",
		"video:render:shorts": "remotion render remotion/index.ts FacebookReelsBlockerShorts out/promo-shorts.mp4",
		"video:still": "remotion still remotion/index.ts FacebookReelsBlockerPromo out/thumbnail.png --frame=260"
	},
	"author": "Safwat Fathi",
	"license": "MIT",
	"devDependencies": {
		"@types/chrome": "^0.0.313",
		"@types/firefox-webext-browser": "^120.0.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"esbuild": "^0.28.2",
		"jsdom": "^30.1.1",
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"@remotion/cli": "4.0.529",
		"@remotion/google-fonts": "^4.0.529",
		"@remotion/transitions": "^4.0.529",
		"lucide-react": "^1.48.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"remotion": "4.0.529"
	}
}
